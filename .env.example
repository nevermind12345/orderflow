# OrderFlow local/Compose environment template.
# Copy this file to .env and replace every CHANGE_ME value locally.
# Never commit .env or use these placeholder values in a deployed environment.

# Runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# SQL Server
SQL_SA_PASSWORD=CHANGE_ME
ConnectionStrings__DefaultConnection=Server=sql,1433;Database=RestaurantOrdering;User Id=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True

# JWT access tokens
Jwt__Issuer=Restaurant.Api
Jwt__Audience=Restaurant.Web
Jwt__SigningKey=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
Jwt__AccessTokenLifetimeMinutes=15

# Refresh-token session
RefreshTokens__LifetimeDays=7
RefreshTokens__CookieName=orderflow.refresh

# Browser access
Cors__AllowedOrigins__0=http://localhost:5173

# Expired-order cancellation worker
OrderCancellation__PlacedOrderTimeoutMinutes=15
OrderCancellation__PollingIntervalSeconds=60

# Deterministic development seed accounts
DevelopmentSeed__Enabled=false
DevelopmentSeed__AdminEmail=admin@example.invalid
DevelopmentSeed__AdminPassword=CHANGE_ME_ADMIN_PASSWORD
DevelopmentSeed__CustomerEmail=customer@example.invalid
DevelopmentSeed__CustomerPassword=CHANGE_ME_CUSTOMER_PASSWORD

# React/Vite build-time configuration.
# Every VITE_ value is visible to the browser and must be non-secret.
VITE_API_BASE_URL=https://localhost:5001

# Production telemetry; leave empty for local development.
APPLICATIONINSIGHTS_CONNECTION_STRING=
